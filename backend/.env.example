# ---------------------------------------------------------------- AI provider
# groq     = free cloud, fastest, needs a key from https://console.groq.com
# ollama   = fully local and private, no key, needs https://ollama.com installed
# together = free tier, key from https://api.together.xyz
AI_PROVIDER=groq

# --- Groq -------------------------------------------------------------------
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE
# Current production models (the old llama-3.x and mixtral names are retired):
#   openai/gpt-oss-20b   -> fast, good default
#   openai/gpt-oss-120b  -> slower, stronger reasoning
GROQ_MODEL=openai/gpt-oss-20b

# --- Ollama (only if AI_PROVIDER=ollama) ------------------------------------
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# --- Together.AI (only if AI_PROVIDER=together) -----------------------------
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# ---------------------------------------------------------------- behaviour
MAX_TOKENS=800
TEMPERATURE=0.7
HISTORY_TURNS=10
REQUEST_TIMEOUT=45

# ---------------------------------------------------------------- identity
USER_NAME=Sir
ASSISTANT_NAME=JARVIS

# ---------------------------------------------------------------- server
PORT=5000
FLASK_DEBUG=True
SECRET_KEY=change-me-in-production
CORS_ORIGINS=*
DATABASE_PATH=../database/jarvis.db

# ---------------------------------------------------------------- extras
DEFAULT_CITY=Frankfurt
UNITS=metric
# Optional, free key from https://newsapi.org
NEWS_API_KEY=
NEWS_COUNTRY=us
